diff --git a/src/density.py b/src/density.py
new file mode 100644
index 0000000..115775f
--- /dev/null
+++ b/src/density.py
@@ -0,0 +1,24 @@
+"""Плотность воды и пересчёт осадки (spec 001). Черновик до сверки с оригиналом."""
+from __future__ import annotations
+
+RHO_SEAWATER_DEFAULT = 1.025  # т/м^3, ждёт подтверждения по стр. 11–12 книги
+
+
+def density_correction(draft_m: float, rho_observed: float,
+                       rho_target: float = RHO_SEAWATER_DEFAULT) -> float:
+    """Осадка в воде плотности rho_target при измеренной draft_m в rho_observed.
+
+    d1 = d0 * (rho0 / rho1) — масса/водоизмещение постоянно, TPC ~ плотность.
+    """
+    if not (0.99 <= rho_observed <= 1.03):
+        raise ValueError(f"подозрительная плотность {rho_observed} т/м3")
+    return draft_m * (rho_observed / rho_target)
+
+
+def dockwater_allowance(dsw_m: float, rho_harbour: float,
+                        rho_sea: float = RHO_SEAWATER_DEFAULT) -> float:
+    """Приблизительная линейная поправка (dock water allowance):
+    corr = dSW * (rho_sea - rho_harbour) / (rho_sea - 1.000)
+    Знак: в более лёгкой воде судно сидит глубже на +corr метров.
+    """
+    return dsw_m * (rho_sea - rho_harbour) / (rho_sea - 1.000)
diff --git a/src/draughts.py b/src/draughts.py
new file mode 100644
index 0000000..e2d5b5e
--- /dev/null
+++ b/src/draughts.py
@@ -0,0 +1,11 @@
+"""Средняя осадка AMD (spec 003). Черновик: Dibble, стр. 18."""
+from __future__ import annotations
+
+
+def arithmetic_mean_draught(d_fwd: float, d_aft: float, d_mid: float) -> float:
+    """AMD = (dF + dA + 6*dM) / 8 — весовая схема Simpson 1-6-1."""
+    return (d_fwd + d_aft + 6.0 * d_mid) / 8.0
+
+
+def mean_of_sides(d_port: float, d_stbd: float) -> float:
+    return (d_port + d_stbd) / 2.0
diff --git a/src/perpendiculars.py b/src/perpendiculars.py
new file mode 100644
index 0000000..5b3a588
--- /dev/null
+++ b/src/perpendiculars.py
@@ -0,0 +1,25 @@
+"""Поправки осадок на перпендикуляры (spec 002).
+
+Черновик до сверки с оригиналом: Dibble, стр. 29–34.
+Контрольное число из книги (стр. 33): tan(22°) * 4.121 = 1.665 м.
+"""
+from __future__ import annotations
+
+import math
+
+
+def mark_incline_correction(angle_deg: float, distance_m: float) -> float:
+    """Линейная поправка осадки из-за наклона маркерной линии.
+
+    corr = tan(alpha) * x   (альфа в градусах, x в метрах, результат в метрах)
+    Знак здесь не трактуется — вызывающий код решает +/− по направлению
+    наклона (см. spec 002, шаг 3; требует сверки со сканом).
+    """
+    return math.tan(math.radians(angle_deg)) * distance_m
+
+
+def trim_to_midships(draft_fwd: float, draft_aft: float) -> float:
+    """Поправка от конца к миделю при линейном изменении осадки по дифференту:
+    половина дифферента. Ориентир книги (стр. 34): Trim aft to midships = 1.0 m.
+    """
+    return abs(draft_aft - draft_fwd) / 2.0
